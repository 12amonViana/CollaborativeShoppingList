rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function listPath(listId) {
      return /databases/$(database)/documents/lists/$(listId);
    }

    function memberPath(listId, userId) {
      return /databases/$(database)/documents/lists/$(listId)/members/$(userId);
    }

    function invitationPath(inviteId) {
      return /databases/$(database)/documents/invitations/$(inviteId);
    }

    function member(listId) {
      return signedIn() && exists(memberPath(listId, request.auth.uid));
    }

    function owner(listId) {
      return member(listId) &&
        get(memberPath(listId, request.auth.uid)).data.role == 'OWNER';
    }

    function active(listId) {
      return get(listPath(listId)).data.status == 'ACTIVE';
    }

    function validAcceptance(inviteId, listId) {
      let invitation = get(invitationPath(inviteId)).data;
      let accepted = getAfter(invitationPath(inviteId)).data;
      return invitation.listId == listId &&
        invitation.status == 'PENDING' &&
        invitation.expiresAt > request.time &&
        get(listPath(listId)).data.status == 'ACTIVE' &&
        accepted.status == 'ACCEPTED' &&
        accepted.acceptedByUserId == request.auth.uid &&
        accepted.acceptedAt == request.time &&
        accepted.diff(invitation).affectedKeys().hasOnly([
          'status', 'acceptedAt', 'acceptedByUserId'
        ]);
    }

    function joiningWithInvitation(listId) {
      let joinedMember = getAfter(memberPath(listId, request.auth.uid)).data;
      return joinedMember.userId == request.auth.uid &&
        joinedMember.role == 'MEMBER' &&
        joinedMember.joinedAt == request.time &&
        joinedMember.acceptedInvitationId is string &&
        validAcceptance(joinedMember.acceptedInvitationId, listId);
    }

    function leavingAsMember(listId) {
      return member(listId) &&
        get(listPath(listId)).data.ownerId != request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        !(request.auth.uid in request.resource.data.memberIds) &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1 &&
        request.resource.data.memberIds.toSet().union([request.auth.uid].toSet()) ==
          resource.data.memberIds.toSet() &&
        !existsAfter(memberPath(listId, request.auth.uid)) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds', 'updatedAt'
        ]);
    }

    function transferringOwnership(listId) {
      let newOwnerId = request.resource.data.ownerId;
      return owner(listId) &&
        newOwnerId != request.auth.uid &&
        newOwnerId in resource.data.memberIds &&
        newOwnerId in request.resource.data.memberIds &&
        !(request.auth.uid in request.resource.data.memberIds) &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1 &&
        request.resource.data.memberIds.toSet().union([request.auth.uid].toSet()) ==
          resource.data.memberIds.toSet() &&
        getAfter(memberPath(listId, newOwnerId)).data.role == 'OWNER' &&
        !existsAfter(memberPath(listId, request.auth.uid)) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerId', 'memberIds', 'updatedAt'
        ]);
    }

    function validItemCreate(itemId) {
      return request.resource.data.keys().hasAll([
          'name', 'normalizedName', 'category', 'quantity', 'inCart', 'updatedAt', 'updatedByUserId'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.normalizedName == itemId &&
        request.resource.data.category in [
          'COLD_CUTS_AND_DAIRY', 'BUTCHER', 'PRODUCE', 'CLEANING', 'FROZEN', 'OTHER'
        ] &&
        request.resource.data.quantity == 1 &&
        request.resource.data.inCart == false &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedByUserId == request.auth.uid;
    }

    function validItemUpdate() {
      return request.resource.data.name == resource.data.name &&
        request.resource.data.normalizedName == resource.data.normalizedName &&
        request.resource.data.get('category', 'OTHER') ==
          resource.data.get('category', 'OTHER') &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity >= 1 &&
        request.resource.data.inCart is bool &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedByUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity', 'inCart', 'lastMarkedByUserId', 'updatedAt', 'updatedByUserId'
        ]) &&
        (
          request.resource.data.inCart == resource.data.inCart ||
          (request.resource.data.inCart == true &&
            request.resource.data.lastMarkedByUserId == request.auth.uid) ||
          (request.resource.data.inCart == false &&
            request.resource.data.lastMarkedByUserId == null)
        );
    }

    function validItemReset(listId) {
      return owner(listId) &&
        get(listPath(listId)).data.status == 'CLOSED' &&
        getAfter(listPath(listId)).data.status == 'ACTIVE' &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.normalizedName == resource.data.normalizedName &&
        request.resource.data.get('category', 'OTHER') ==
          resource.data.get('category', 'OTHER') &&
        request.resource.data.quantity == 1 &&
        request.resource.data.inCart == false &&
        request.resource.data.lastMarkedByUserId == null &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedByUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity', 'inCart', 'lastMarkedByUserId', 'updatedAt', 'updatedByUserId'
        ]);
    }

    match /lists/{listId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if
        (member(listId) && active(listId) &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])) ||
        (owner(listId) && resource.data.status == 'ACTIVE' &&
          request.resource.data.status == 'CLOSED' &&
          request.resource.data.closedAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'closedAt', 'updatedAt'
          ])) ||
        (owner(listId) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'updatedAt'
          ])) ||
        (owner(listId) && resource.data.status == 'CLOSED' &&
          request.resource.data.status == 'ACTIVE' &&
          request.resource.data.closedAt == null &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'closedAt', 'updatedAt'
          ])) ||
        (signedIn() && !(request.auth.uid in resource.data.memberIds) &&
          request.auth.uid in request.resource.data.memberIds &&
          request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
          request.resource.data.memberIds.toSet() ==
            resource.data.memberIds.toSet().union([request.auth.uid].toSet()) &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'memberIds', 'updatedAt'
          ]) && joiningWithInvitation(listId)) ||
        leavingAsMember(listId) ||
        transferringOwnership(listId);
      allow delete: if owner(listId);

      match /members/{userId} {
        allow read: if member(listId);
        allow create: if signedIn() && userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.displayName is string &&
          request.resource.data.displayName.size() > 0 &&
          request.resource.data.displayName.size() <= 100 &&
          (
            (request.resource.data.role == 'OWNER' &&
              getAfter(listPath(listId)).data.ownerId == request.auth.uid) ||
            (request.resource.data.role == 'MEMBER' &&
              request.resource.data.acceptedInvitationId is string &&
              validAcceptance(request.resource.data.acceptedInvitationId, listId))
          );
        allow update: if owner(listId) &&
          resource.data.role == 'MEMBER' &&
          request.resource.data.role == 'OWNER' &&
          getAfter(listPath(listId)).data.ownerId == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);
        allow delete: if owner(listId) ||
          (signedIn() && userId == request.auth.uid &&
            !(request.auth.uid in getAfter(listPath(listId)).data.memberIds));
      }

      match /items/{itemId} {
        allow read: if member(listId);
        allow create: if member(listId) && active(listId) && validItemCreate(itemId);
        allow update: if
          (member(listId) && active(listId) && validItemUpdate()) ||
          validItemReset(listId);
        allow delete: if
          (member(listId) && active(listId)) || owner(listId);
      }
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /invitations/{inviteId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && inviteId.size() == 32 &&
        owner(request.resource.data.listId) && active(request.resource.data.listId) &&
        request.resource.data.keys().hasAll([
          'listId', 'listName', 'inviterId', 'inviterDisplayName', 'status',
          'createdAt', 'expiresAt', 'acceptedAt', 'acceptedByUserId'
        ]) &&
        request.resource.data.listName ==
          get(listPath(request.resource.data.listId)).data.name &&
        request.resource.data.inviterId == request.auth.uid &&
        request.resource.data.inviterDisplayName is string &&
        request.resource.data.inviterDisplayName.size() > 0 &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt > request.time + duration.value(179, 'm') &&
        request.resource.data.expiresAt <= request.time + duration.value(181, 'm') &&
        request.resource.data.acceptedAt == null &&
        request.resource.data.acceptedByUserId == null;
      allow update: if signedIn() && validAcceptance(inviteId, resource.data.listId) &&
        getAfter(listPath(resource.data.listId)).data.memberIds.hasAny([request.auth.uid]) &&
        getAfter(memberPath(resource.data.listId, request.auth.uid)).data.role == 'MEMBER';
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
